---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact | Perfect Sync Press" description="Contact Perfect Sync Press for reader questions, review copies, media inquiries, rights, permissions, and general information.">
  <section class="hero small-hero">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch.</h1>
      <p class="lede">Use the form below for general inquiries, review copies, media questions, rights, permissions, or anything related to <em>Perfectly in Sync</em>.</p>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div class="form-card">
        <form class="contact-form" action="https://formsubmit.co/info@insyncpub.com" method="POST">
          <input type="hidden" name="_subject" value="New message from Perfect Sync Press website" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />

          <label>
            Name
            <input type="text" name="name" autocomplete="name" required />
          </label>

          <label>
            Email
            <input type="email" name="email" autocomplete="email" required />
          </label>

          <label>
            Inquiry type
            <select name="inquiry_type" required>
              <option value="">Select one</option>
              <option value="General inquiry">General inquiry</option>
              <option value="Review copy">Review copy</option>
              <option value="Media or interview">Media or interview</option>
              <option value="Rights or permissions">Rights or permissions</option>
              <option value="Reader message">Reader message</option>
            </select>
          </label>

          <label>
            Message
            <textarea name="message" rows="7" required></textarea>
          </label>

          <button class="button primary" type="submit">Send Message</button>
        </form>
      </div>

      <aside class="quote-card compact">
        <p class="eyebrow">Perfect Sync Press</p>
        <h3>For inquiries about the book, author, media, reviews, or rights.</h3>
        <p class="note">Messages submitted here are sent to info@insyncpub.com.</p>
      </aside>
    </div>
  </section>
</BaseLayout>