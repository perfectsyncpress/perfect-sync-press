---
const links = [
  {
    label: 'Books2Read',
    href: 'https://books2read.com/u/bzERdn',
    note: 'Universal book link',
  },
  {
    label: 'Amazon',
    href: 'https://www.amazon.ca/gp/product/B0GY523TPN?tag=books2read02-20',
    note: 'Kindle edition',
  },
  {
    label: 'Apple Books',
    href: 'https://books.apple.com/us/book/perfectly-in-sync/id6766278470',
    note: 'Apple Books',
  },
  {
    label: 'Google Play Books',
    href: 'https://play.google.com/store/books/details?id=XaXVEQAAQBAJ',
    note: 'Google Play',
  },
  {
    label: 'Kobo',
    href: 'https://www.kobo.com/ca/en/ebook/perfectly-in-sync?sid=4d17fee6-261f-4240-9a9a-b559db437525&ssid=68a5ioa0wj3fJSbaldtGY',
    note: 'Kobo store',
  },
];
---

<div class="retail-grid">
  {links.map((link) => (
    <a class="retail-link" href={link.href} target="_blank" rel="noreferrer">
      <span>
        <strong>{link.label}</strong>
        <small>{link.note}</small>
      </span>
      <span aria-hidden="true">↗</span>
    </a>
  ))}
</div>